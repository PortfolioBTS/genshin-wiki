# Необязательная настройка EmailJS (https://www.emailjs.com).
# Если переменные пустые, сайт работает в демо-режиме: коды подтверждения
# показываются на экране, а предложения правок сохраняются только в браузере.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_VERIFY=
VITE_EMAILJS_TEMPLATE_PROPOSAL=
